# Settings for the server. Make your own .env with:  bash init-env.sh
# The secrets are generated for you. You fill in DOMAIN, MONGODB_URI and ANTHROPIC_API_KEY. Never commit .env.

# production, or staging for a test server
APP_ENV=production

# The address people use, without https://. For example agentx-yourname.duckdns.org or api.yourcompany.co.ke.
# It must point at this server's public IP before the first start, or the certificate cannot be issued.
DOMAIN=

# MongoDB Atlas connection string, with the database name in it
MONGODB_URI=

# Your Anthropic API key
ANTHROPIC_API_KEY=

# Generated by init-env.sh. Do not change INTERNAL_KEY or the passwords later unless you restart everything.
INTERNAL_KEY=
AGENTX_TOKEN_SECRET=
REDIS_PASSWORD=
RABBITMQ_USER=agentx
RABBITMQ_PASSWORD=
# Locks the business credentials people save. Generated once. Back it up outside this server.
# If it is lost or changed, saved credentials can never be opened again.
AGENTX_VAULT_KEY=

# How sign-in codes reach people. log writes them to the service log (fine while you test). Use sms for customers.
CODE_DELIVERY=log
SMS_USERNAME=sandbox
SMS_API_KEY=
SMS_SENDER_ID=
SMS_BASE_URL=https://api.sandbox.africastalking.com

# Email. log writes emails to the service log. smtp sends them, with the MAIL_ values below.
MAIL_TRANSPORT=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@localhost
MAIL_FROM_NAME=Daraja Agent-X
MAIL_STARTTLS=true
MAIL_SSL=false

# Shown to customers and in email footers. All optional.
BUSINESS_NAME=Daraja Agent-X
BUSINESS_SUPPORT_PHONE=
AGENTX_WEBSITE=
AGENTX_APP_URL=

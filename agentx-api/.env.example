# Copy to .env and fill in. Never commit the real .env file.
INTERNAL_KEY=change-me-to-a-long-random-string
# At least 32 random characters. Changing it signs every phone out.
AGENTX_TOKEN_SECRET=
# Locks the business credentials people save in the app. 32 random bytes in Base64: openssl rand -base64 32
# Keep a copy somewhere safe. If it is lost or changed, saved credentials cannot be opened. Blank turns the feature off.
AGENTX_VAULT_KEY=

# Public HTTPS address of this service (the links in the chat point here)
AGENTX_PUBLIC_BASE_URL=https://app.example.com

# Private address of agent-service, which keeps the chat
AGENT_BASE_URL=http://localhost:8082

# How sign-in codes reach people:
#   log  written to this service's log only (default, for a developer)
#   dev  also returned to the app so a test console can sign in on its own. NEVER on a real system.
#   sms  sent by text message through Africa's Talking (fill in the SMS_ values)
CODE_DELIVERY=log
AGENTX_APP_NAME=Daraja Agent-X
SMS_USERNAME=sandbox
SMS_API_KEY=
SMS_SENDER_ID=
SMS_BASE_URL=https://api.sandbox.africastalking.com

# App links (fill in after the app is built and signed)
AGENTX_ANDROID_PACKAGE=com.example.agentx
AGENTX_ANDROID_SHA256=
AGENTX_IOS_APP_ID=

# Hand-off values. Verify with the M-Pesa team. Empty means the app shows guided steps only.
HANDOFF_USSD_MAIN=*334#
HANDOFF_MPESA_ANDROID_PACKAGE=
HANDOFF_MPESA_IOS_URL=
HANDOFF_USSD_SEND_MONEY=
HANDOFF_USSD_PAY_BILL=
HANDOFF_USSD_PAY_TILL=
HANDOFF_USSD_BUY_AIRTIME=

AGENTX_MAX_AMOUNT=250000
AGENTX_ACTION_TTL=PT30M

DB_USER=app
DB_PASSWORD=app
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Only to use console/console.html from python3 -m http.server. Leave empty otherwise.
CORS_ALLOWED_ORIGINS=

# Database: postgresql, mysql or mongodb (default postgresql).
# DATABASE_TYPE can also be changed in src/main/resources/application.yml.
DATABASE_TYPE=postgresql
# One of these is used, depending on DATABASE_TYPE. DB_URL overrides the first two when set.
# POSTGRES_URL=jdbc:postgresql://localhost:5432/agentx
# MYSQL_URL=jdbc:mysql://localhost:3306/agentx?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&preserveInstants=true&useSSL=false&allowPublicKeyRetrieval=true
# MONGODB_URI=mongodb://localhost:27017/agentx

# Business requests from the chat (optional, these are the defaults)
# AGENTX_BUSINESS_MAX_AMOUNT=150000
# AGENTX_BUSINESS_APPROVE_COLLECTIONS=false

# ---- Email (optional). transport log = write emails to the log only; smtp = really send ----
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@localhost
MAIL_FROM_NAME=Daraja Agent-X
MAIL_REPLY_TO=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=true
MAIL_SSL=false
# MAIL_REPORT_ALLOW_EXTERNAL=true
# MAIL_REPORT_ALLOWED_DOMAINS=yourcompany.co.ke,accountant.co.ke
# MAIL_NOTIFY_SIGN_IN=true

# ---- Where profile pictures are kept: local (a folder here) or network (a mounted share) ----
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/files
# STORAGE_NETWORK_PATH=/mnt/agentx
# STORAGE_NETWORK_SUBFOLDER=agentx-api

# ---- Sign up ----
SIGNUP_ENABLED=true

# Copy to .env and fill in. Never commit the real .env file.
# Which copy of the system this is: development, staging (uat means the same) or production.
#   development  your own machine. Nothing is checked.
#   staging      the shared test copy. Warns about settings that production would refuse.
#   production   the live system. Refuses to start with CODE_DELIVERY=dev, CORS_ALLOWED_ORIGINS set, an example
#                INTERNAL_KEY or an http or localhost AGENTX_PUBLIC_BASE_URL.
# Outside production, business accounts set to Safaricom's production Daraja are refused, so a test copy cannot move
# real money, and email subjects start with [DEV] or [STAGING].
APP_ENV=development
# Lets a copy that is not production call live Daraja anyway. Leave false unless you really mean it.
AGENTX_ALLOW_LIVE_DARAJA=false

INTERNAL_KEY=change-me-to-a-long-random-string
# At least 32 random characters. Changing it signs every phone out.
AGENTX_TOKEN_SECRET=
# Locks the business credentials people save in the app. 32 random bytes in Base64: openssl rand -base64 32
# Keep a copy somewhere safe. If it is lost or changed, saved credentials cannot be opened. Blank turns the feature off.
AGENTX_VAULT_KEY=

# Public HTTPS address of this service (the links in the chat point here)
AGENTX_PUBLIC_BASE_URL=https://app.example.com

# Private address of agent-service, which keeps the chat
AGENT_BASE_URL=http://localhost:8082

# How sign-in codes reach people:
#   log  written to this service's log only (default, for a developer)
#   dev  also returned to the app so a test console can sign in on its own. NEVER on a real system:
#        anyone who can reach this service could sign in as any phone number.
#   sms  sent by text message through Africa's Talking (fill in the SMS_ values)
# For console/console.html on your own machine, change log to dev in your .env (not in Git).
CODE_DELIVERY=log
AGENTX_APP_NAME=Daraja Agent-X
SMS_USERNAME=sandbox
SMS_API_KEY=
SMS_SENDER_ID=
SMS_BASE_URL=https://api.sandbox.africastalking.com

# App links (fill in after the app is built and signed)
AGENTX_ANDROID_PACKAGE=com.example.agentx
AGENTX_ANDROID_SHA256=
AGENTX_IOS_APP_ID=

# Hand-off values. Verify with the M-Pesa team. Empty means the app shows guided steps only.
HANDOFF_USSD_MAIN=*334#
HANDOFF_MPESA_ANDROID_PACKAGE=
HANDOFF_MPESA_IOS_URL=
HANDOFF_USSD_SEND_MONEY=
HANDOFF_USSD_PAY_BILL=
HANDOFF_USSD_PAY_TILL=
HANDOFF_USSD_BUY_AIRTIME=

AGENTX_MAX_AMOUNT=250000
AGENTX_ACTION_TTL=PT30M

DB_USER=app
DB_PASSWORD=app
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Lets console/console.html (python3 -m http.server 8000) call this service. Leave empty in production.
CORS_ALLOWED_ORIGINS=http://localhost:8000

# Database: postgresql, mysql or mongodb (default mongodb).
# DATABASE_TYPE can also be changed in src/main/resources/application.yml.
DATABASE_TYPE=mongodb
# One of these is used, depending on DATABASE_TYPE. DB_URL overrides the first two when set.
# POSTGRES_URL=jdbc:postgresql://localhost:5432/agentx
# MYSQL_URL=jdbc:mysql://localhost:3306/agentx?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&preserveInstants=true&useSSL=false&allowPublicKeyRetrieval=true
# MONGODB_URI=mongodb://localhost:27017/agentx

# Where the Safaricom public certificates are. Empty uses the sandbox and production folders inside the jar.
# DARAJA_CERTS_DIR=
# DARAJA_SANDBOX_URL=https://sandbox.safaricom.co.ke
# DARAJA_PRODUCTION_URL=https://api.safaricom.co.ke

# Business requests from the chat (optional, these are the defaults)
# AGENTX_BUSINESS_MAX_AMOUNT=150000
# AGENTX_BUSINESS_APPROVE_COLLECTIONS=false
# A STK Push whose answer from Safaricom never arrives is checked directly after MIN_AGE, and marked UNKNOWN after GIVE_UP_AFTER (optional, these are the defaults)
# AGENTX_RECONCILE_ENABLED=true
# AGENTX_RECONCILE_INTERVAL=PT1M
# AGENTX_RECONCILE_MIN_AGE=PT2M
# AGENTX_RECONCILE_GIVE_UP_AFTER=PT15M

# ---- Email (optional). transport log = write emails to the log only; smtp = really send ----
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@localhost
MAIL_FROM_NAME=Daraja Agent-X
# Who a reply goes to is not set here. A report a customer emails to other people carries that customer's own verified
# profile email as the reply address. MAIL_REPLY_TO is only a fallback for the system emails, leave it out normally.
# MAIL_REPLY_TO=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
# With or without quotes, with or without spaces. A Gmail app password can be pasted as Google shows it.
MAIL_PASSWORD=
MAIL_STARTTLS=true
MAIL_SSL=false
# MAIL_REPORT_ALLOW_EXTERNAL=true
# MAIL_REPORT_ALLOWED_DOMAINS=yourcompany.co.ke,accountant.co.ke
# MAIL_NOTIFY_SIGN_IN=true

# ---- Email look (optional). Shown in the footer and the Open button of every email. A blank value is left out ----
# AGENTX_SUPPORT_EMAIL=
# AGENTX_WEBSITE=https://example.com
# AGENTX_APP_URL=https://example.com/app
# AGENTX_TAGLINE=M-Pesa payments and reports, by chat
# AGENTX_COMPANY=
# AGENTX_COMPANY_ADDRESS=
# AGENTX_BRAND_MARK=
# MAIL_TEMPLATES_DIR=

# ---- Where files are kept (profile pictures, and chat files when agent-service uses CHAT_MEDIA_STORE=agentx) ----
# local (a folder here), network (a mounted share), database (the database above, no disk needed) or cloudinary
# On a host whose disk is wiped on every deploy (Render, for example) use database or cloudinary.
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/files
# STORAGE_NETWORK_PATH=/mnt/agentx
# STORAGE_NETWORK_SUBFOLDER=agentx-api
# STORAGE_NETWORK_CREATE=false
# Used when STORAGE_TYPE=database. MongoDB documents stop at 16 MB.
# STORAGE_DB_MAX_FILE_BYTES=15728640
# Used when STORAGE_TYPE=cloudinary. Give the address from the dashboard, or the three STORAGE_CLOUDINARY_ values.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# STORAGE_CLOUDINARY_CLOUD_NAME=
# STORAGE_CLOUDINARY_API_KEY=
# STORAGE_CLOUDINARY_API_SECRET=
# STORAGE_CLOUDINARY_FOLDER=agentx
# How often database files past their keep time are removed
# STORAGE_PURGE_INTERVAL=PT1H
# STORAGE_MAX_PICTURE_BYTES=3145728

# ---- Sign up ----
SIGNUP_ENABLED=true

# Copy to .env and fill in. Never commit the real .env file.

# Shared secret for service to service calls (X-Internal-Key header)
INTERNAL_KEY=change-me-to-a-long-random-string

# Safaricom Daraja
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Public HTTPS URL that Safaricom can reach (ngrok or Cloudflare Tunnel while developing).
# If a gateway or ingress adds a path prefix, include it here, otherwise callbacks return 401/404.
PUBLIC_BASE_URL=https://your-tunnel.example.com
# Random string placed in the callback URL path
MPESA_CALLBACK_SECRET=change-me-too
# Optional: comma separated Safaricom source IPs
MPESA_CALLBACK_ALLOWED_IPS=

# Optional: payouts, refunds, balance, status and reversal (B2C etc). Leave blank for STK Push only.
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
# Path to the Safaricom public certificate, mounted into the container
MPESA_CERTIFICATE_PATH=
# Or paste a ready made SecurityCredential instead of the two lines above
MPESA_SECURITY_CREDENTIAL=
# Confirm the current versions on the Daraja portal
MPESA_B2C_PATH=/mpesa/b2c/v3/paymentrequest
MPESA_C2B_REGISTER_PATH=/mpesa/c2b/v2/registerurl

# Payout limits in KES. A second person must approve every payout.
OPERATIONS_MAX_PAYOUT=20000
OPERATIONS_DAILY_PAYOUT_LIMIT=100000
OPERATIONS_ALLOW_SELF_APPROVAL=false

# Shown on receipts
BUSINESS_NAME=Our Business
BUSINESS_SUPPORT_PHONE=

# Staff. Everyone else who chats is treated as a customer. Roles: STAFF, APPROVER, ADMIN
STAFF_MEMBERS_0_PHONE=0712345678
STAFF_MEMBERS_0_NAME=Owner
STAFF_MEMBERS_0_ROLE=ADMIN
# Add more people by increasing the number. Never leave a PHONE line empty, the service will not start.
# STAFF_MEMBERS_1_PHONE=0722000000
# STAFF_MEMBERS_1_NAME=Second person
# STAFF_MEMBERS_1_ROLE=APPROVER

# Limits in KES
PAYMENT_LIMIT_PER_TX=70000
PAYMENT_LIMIT_PER_DAY=150000

# Infrastructure (defaults match docker-compose.yml)
DB_USER=app
DB_PASSWORD=app
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Only to use console/console.html from python3 -m http.server. Leave empty otherwise.
CORS_ALLOWED_ORIGINS=

# Database: postgresql, mysql or mongodb (default postgresql).
# DATABASE_TYPE can also be changed in src/main/resources/application.yml.
DATABASE_TYPE=postgresql
# One of these is used, depending on DATABASE_TYPE. DB_URL overrides the first two when set.
# POSTGRES_URL=jdbc:postgresql://localhost:5432/payments
# MYSQL_URL=jdbc:mysql://localhost:3306/payments?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&preserveInstants=true&useSSL=false&allowPublicKeyRetrieval=true
# MONGODB_URI=mongodb://localhost:27017/payments

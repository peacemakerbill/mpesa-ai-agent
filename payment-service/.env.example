# Settings for payment-service. Copy to .env and fill in. Never commit the real .env file.
# INTERNAL_KEY must be the same value in agent-service and companion-api.
INTERNAL_KEY=change-me-to-a-long-random-string

# Port this service listens on
SERVER_PORT=8083

# Safaricom Daraja. Sandbox: https://sandbox.safaricom.co.ke   Production: https://api.safaricom.co.ke
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# Required. From your app on the Daraja portal.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
# Required. The passkey for your shortcode (the sandbox passkey is on the Daraja portal).
MPESA_PASSKEY=
# Paybill: CustomerPayBillOnline   Till number: CustomerBuyGoodsOnline
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Public HTTPS address that Safaricom can reach (ngrok or Cloudflare Tunnel while developing).
# If a gateway or ingress adds a path prefix, include it here, otherwise callbacks return 401/404.
PUBLIC_BASE_URL=https://your-tunnel.example.com
# Random string placed in the callback URL path, so only Safaricom (who knows the URL) can post to it
MPESA_CALLBACK_SECRET=change-me-to-a-long-random-string
# Optional: comma separated Safaricom source IPs. Empty means no IP check.
MPESA_CALLBACK_ALLOWED_IPS=

# Optional: payouts, refunds, balance, status and reversal (B2C etc). Leave blank for STK Push only.
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
# Path to the Safaricom public certificate, mounted into the container
MPESA_CERTIFICATE_PATH=
# Or paste a ready made SecurityCredential instead of the two lines above
MPESA_SECURITY_CREDENTIAL=
# Confirm the current versions on the Daraja portal
MPESA_B2C_PATH=/mpesa/b2c/v3/paymentrequest
MPESA_C2B_REGISTER_PATH=/mpesa/c2b/v2/registerurl
MPESA_C2B_RESPONSE_TYPE=Completed
# Only for dynamic QR codes
MPESA_QR_MERCHANT_NAME=
MPESA_QR_TRX_CODE=PB
MPESA_QR_CPI=

# Payout limits in KES. A second person must approve every payout.
OPERATIONS_MAX_PAYOUT=20000
OPERATIONS_DAILY_PAYOUT_LIMIT=100000
OPERATIONS_ALLOW_SELF_APPROVAL=false

# Shown on receipts
BUSINESS_NAME=Our Business
BUSINESS_SUPPORT_PHONE=

# Staff. Everyone else who chats is treated as a customer. Roles: STAFF, APPROVER, ADMIN
STAFF_MEMBERS_0_PHONE=0712345678
STAFF_MEMBERS_0_NAME=Owner
STAFF_MEMBERS_0_ROLE=ADMIN
# Add more people by increasing the number. Never leave a PHONE line empty, the service will not start.
# STAFF_MEMBERS_1_PHONE=0722000000
# STAFF_MEMBERS_1_NAME=Second person
# STAFF_MEMBERS_1_ROLE=APPROVER

# Limits in KES
PAYMENT_LIMIT_PER_TX=70000
PAYMENT_LIMIT_PER_DAY=150000

# Database: postgresql, mysql or mongodb (default mongodb).
DATABASE_TYPE=mongodb
DB_USER=app
DB_PASSWORD=app
# One of these is used, depending on DATABASE_TYPE. DB_URL overrides the two SQL ones when set.
# POSTGRES_URL=jdbc:postgresql://localhost:5432/payments
# MYSQL_URL=jdbc:mysql://localhost:3306/payments?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&preserveInstants=true&useSSL=false&allowPublicKeyRetrieval=true
MONGODB_URI=mongodb://localhost:27017/payments?serverSelectionTimeoutMS=5000

# RabbitMQ (defaults match docker-compose.yml)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Browser origins allowed for the test console, comma separated. Empty means off. Never set this in production.
CORS_ALLOWED_ORIGINS=

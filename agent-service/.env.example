# Settings for agent-service. Copy to .env and fill in. Never commit the real .env file.
# INTERNAL_KEY must be the same value in ganji-api and payment-service.
INTERNAL_KEY=change-me-to-a-long-random-string

# Required. Your Anthropic API key.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=1024

# Port this service listens on
SERVER_PORT=8082

# Where chat state is kept: redis, or memory (this process only, for local development)
AGENT_STORE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Private address of ganji-api, and the public address phones open from links in chat
GANJI_BASE_URL=http://localhost:8084
GANJI_PUBLIC_BASE_URL=https://app.example.com

# Only used when AGENT_BUSINESS_PAYMENTS=true
PAYMENT_BASE_URL=http://localhost:8083
# Off: the agent only prepares requests for the customer's own M-Pesa (ganji-api).
# On: also offers the business tools that need payment-service (Daraja).
AGENT_BUSINESS_PAYMENTS=false

BUSINESS_NAME=Our Business
BUSINESS_SUPPORT_PHONE=
# Staff numbers that get customer escalations, comma separated, for example 254712345678,254722000000
AGENT_ESCALATION_PHONES=
AGENT_RATE_LIMIT_PER_MINUTE=12

# Voice notes to text. Audio leaves your servers when this is on.
STT_ENABLED=false
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
# Leave blank to detect the language (customers mix English and Swahili)
STT_LANGUAGE=

# Spoken replies to voice notes
TTS_ENABLED=false
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Browser origins allowed for the test console, comma separated. Empty means off. Never set this in production.
CORS_ALLOWED_ORIGINS=

# Settings for agent-service. Copy to .env and fill in. Never commit the real .env file.
# INTERNAL_KEY must be the same value in agentx-api and agent-service.
INTERNAL_KEY=change-me-to-a-long-random-string

# Which copy of the system this is: development, staging (uat means the same) or production. Use the same value as agentx-api.
# production refuses to start with AGENT_STORE=memory, CORS_ALLOWED_ORIGINS set, an example INTERNAL_KEY or an http AGENTX_PUBLIC_BASE_URL.
APP_ENV=development

# Required. Your Anthropic API key.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=1024

# Port this service listens on
SERVER_PORT=8082

# Where chat state is kept: redis, or memory (this process only, for local development)
AGENT_STORE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Private address of agentx-api, and the public address phones open from links in chat
AGENTX_BASE_URL=http://localhost:8084
AGENTX_PUBLIC_BASE_URL=https://app.example.com

BUSINESS_NAME=Our Business
BUSINESS_SUPPORT_PHONE=
# Staff numbers that get customer escalations, comma separated, for example 254712345678,254722000000
AGENT_ESCALATION_PHONES=
AGENT_RATE_LIMIT_PER_MINUTE=12

# Voice notes to text. Audio leaves your servers when this is on.
STT_ENABLED=false
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
# Leave blank to detect the language (customers mix English and Swahili)
STT_LANGUAGE=

# Spoken replies to voice notes
TTS_ENABLED=false
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Browser origins allowed for the test console, comma separated. Empty means off. Never set this in production.
CORS_ALLOWED_ORIGINS=

# Where chat photos, voice notes and documents are kept: state (Redis, 24 hours), local, s3, or agentx.
# agentx sends them to agentx-api, which keeps them in its database, a folder or Cloudinary (set STORAGE_TYPE there). Needs no disk here.
# CHAT_MEDIA_STORE=agentx
# CHAT_MEDIA_RETENTION_DAYS=30

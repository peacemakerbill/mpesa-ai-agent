# Copy to .env and fill in. Never commit the real .env file.
INTERNAL_KEY=change-me-to-a-long-random-string

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Voice notes. Needs a speech to text provider with an OpenAI compatible /audio/transcriptions endpoint.
# Audio is sent to that provider, tell your customers and check the Kenya Data Protection Act position first.
STT_ENABLED=false
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
STT_LANGUAGE=

# Optional spoken replies to voice notes
TTS_ENABLED=false
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy

BUSINESS_NAME=Our Business
BUSINESS_SUPPORT_PHONE=

# Staff who receive escalations (254 format, comma separated)
# Leave false to work only with customers' own M-Pesa. true adds the business tools (Daraja, refunds, payouts)
AGENT_BUSINESS_PAYMENTS=false
AGENT_ESCALATION_PHONES=
AGENT_RATE_LIMIT_PER_MINUTE=12

# Addresses of the other services (docker-compose sets these for you)
GANJI_BASE_URL=http://localhost:8084
# Public HTTPS address of ganji-api. The link in the chat is this address plus /a/REQUEST_ID
GANJI_PUBLIC_BASE_URL=https://app.example.com
# Only needed when AGENT_BUSINESS_PAYMENTS=true
PAYMENT_BASE_URL=http://localhost:8083
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Only to use console/console.html from python3 -m http.server. Leave empty otherwise.
CORS_ALLOWED_ORIGINS=
